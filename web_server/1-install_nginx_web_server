#!/usr/bin/env bash
# Installs and configures an Nginx web server

# Update package lists
apt-get update

# Install Nginx without prompting for confirmation
apt-get install -y nginx

# Add the required string to the index.html file
echo "Holberton School" > /var/www/html/index.html

# Start the Nginx service (using service instead of systemctl as required)
service nginx start
